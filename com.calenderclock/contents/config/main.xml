<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="showWeekday" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showDate" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showTime" type="Bool">
      <default>true</default>
    </entry>
    <entry name="language" type="String">
      <default></default>
    </entry>
    <entry name="panelFontFamily" type="String">
      <default>monospace</default>
    </entry>
    <entry name="panelFontSize" type="Int">
      <default>-1</default>
    </entry>
    <entry name="nerdFontIcons" type="Bool">
      <default>false</default>
    </entry>
    <entry name="useThemeColors" type="Bool">
      <default>true</default>
    </entry>
  </group>
</kcfg>
